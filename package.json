{
	"name": "payload-template-project",
	"version": "1.35.0",
	"description": "Get started quickly with Next.js, Clerk Auth, Payload CMS and MongoDB.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"postbuild": "next-sitemap",
		"release": "semantic-release"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1100.0",
		"@base-ui/react": "^1.6.0",
		"@clerk/backend": "^3.14.0",
		"@clerk/nextjs": "^7.6.3",
		"@payloadcms/db-mongodb": "3.86.0",
		"@payloadcms/email-resend": "3.86.0",
		"@payloadcms/live-preview-react": "^3.86.0",
		"@payloadcms/next": "3.86.0",
		"@payloadcms/plugin-redirects": "^3.86.0",
		"@payloadcms/plugin-seo": "^3.86.0",
		"@payloadcms/richtext-lexical": "3.86.0",
		"@payloadcms/storage-s3": "3.86.0",
		"@payloadcms/ui": "3.86.0",
		"@tailwindcss/postcss": "^4.3.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cross-env": "^10.1.0",
		"dotenv": "17.4.2",
		"graphql": "^17.0.2",
		"lucide-react": "^1.28.0",
		"motion": "^12.43.0",
		"next": "16.2.12",
		"next-sitemap": "^4.2.3",
		"next-themes": "^0.4.6",
		"payload": "3.86.0",
		"postcss": "^8.5.25",
		"prism-react-renderer": "^2.4.1",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"shadcn": "^4.16.0",
		"sharp": "0.35.3",
